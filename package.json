{
  "name": "next-ai-advanced",
  "version": "1.0.0",
  "description": "Nextjs kit AI",
  "homepage": "https://github.com/tanthuqb/next-ai-advanced#readme",
  "bugs": {
    "url": "https://github.com/tanthuqb/next-ai-advanced/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanthuqb/next-ai-advanced.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-embeddings": "npm run embeddings && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "embeddings": "tsx lib/generate-embeddings.ts",
    "embeddings:refresh": "tsx lib/generate-embeddings.ts --refresh",
    "functions": "supabase functions serve Embedding --no-verify-jwt --env-file ./supabase/functions/.env.secrets",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "sqlKeywordCase": "lower"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.79",
    "@ai-sdk/react": "^4.0.116",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.117.1",
    "ai": "^7.0.113",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.48.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unist-builder": "^4.0.0",
    "unist-util-filter": "^5.0.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
