# Next.js app environment variables (local + Vercel)
# Copy to .env.local (preferred) or .env and fill in real values. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server only. Used by the batch script `npm run embeddings` (writes are service-role only).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google AI Studio key used by app/api/chat/route.ts (chat) and `npm run embeddings`
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key

# --- Admin (/admin, /api/ingest, saveDocument) ---
# If ADMIN_PASSWORD is empty, admin is locked (fail closed).
ADMIN_PASSWORD=choose_a_long_admin_password
# Random string, at least 32 characters, used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters

# --- Embedding Edge Function ---
# Sent as the x-ingest-secret header; must equal the function secret INGEST_SECRET.
INGEST_SECRET=replace_with_a_random_shared_secret

# --- Gemini quota protection (optional) ---
# CHAT_RATE_LIMIT_PER_MIN=10        # /api/chat requests per client IP per minute
# CHAT_MAX_MESSAGE_CHARS=4000       # max length of the latest user message
# CHAT_MAX_HISTORY_MESSAGES=20      # most recent messages sent to the model
# ADMIN_LOGIN_RATE_LIMIT_PER_MIN=10 # sign-in attempts per client IP per minute

# --- Playwright E2E (optional) ---
# Set these in your shell when running `npm run test:e2e`; they are not read from this file.
# E2E_PORT=3102            # port for the test web server (default 3102)
# E2E_DEV_SERVER=1         # use `next dev` instead of `next build && next start`
# E2E_SKIP_LIVE=1          # skip tests that call the real Gemini / Supabase APIs
# E2E_ALLOW_INGEST=1       # enable the /api/ingest live test (WRITES to the remote DB)
