# Next.js app environment variables (local + Vercel)
# Copy to .env.local (preferred) or .env and fill in real values. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server only. Used by the batch script `npm run embeddings` (writes are service-role only).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google AI Studio key used by app/api/chat/route.ts (chat) and `npm run embeddings`
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key

# --- Playwright E2E (optional) ---
# Set these in your shell when running `npm run test:e2e`; they are not read from this file.
# E2E_PORT=3102            # port for the test web server (default 3102)
# E2E_DEV_SERVER=1         # use `next dev` instead of `next build && next start`
# E2E_SKIP_LIVE=1          # skip tests that call the real Gemini / Supabase APIs
# E2E_ALLOW_INGEST=1       # enable the /api/ingest live test (WRITES to the remote DB)
